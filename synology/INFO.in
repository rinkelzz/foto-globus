package="fotoglobus"
version="@VERSION@"
os_min_ver="7.0-40000"
displayname="Foto-Globus"
description="Zeigt die Fotos aus Synology Photos als Pinnadeln auf einer Weltkugel – persönliche und gemeinsame Fotos, nach den Ordnerrechten in DSM."
description_ger="Zeigt die Fotos aus Synology Photos als Pinnadeln auf einer Weltkugel – persönliche und gemeinsame Fotos, nach den Ordnerrechten in DSM."
description_enu="Shows your Synology Photos as pins on a 3D globe – personal and shared photos, respecting DSM folder permissions (German UI)."
arch="noarch"
maintainer="rinkelzz"
maintainer_url="https://github.com/rinkelzz/foto-globus"
distributor="rinkelzz"
distributor_url="https://github.com/rinkelzz/foto-globus"
support_url="https://github.com/rinkelzz/foto-globus/issues"
thirdparty="yes"
beta="no"
startable="yes"
ctl_stop="yes"
silent_upgrade="yes"
dsmuidir="ui"
dsmappname="SYNO.SDS.FotoGlobus.Application"
